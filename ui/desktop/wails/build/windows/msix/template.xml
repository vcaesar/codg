<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="codg"
        Arguments=""
        InstallLocation="C:\Program Files\AtomAI\Codg">
    </Installer>
    <PackageInformation
        PackageName="Codg"
        PackageDisplayName="Codg"
        PublisherName="US=AtomAI"
        PublisherDisplayName="AtomAI"
        Version="0.20.0.0"
        PackageDescription="Atom codg agent app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.atomai.codg"
                Description="Atom codg agent app"
                DisplayName="Codg"
                ExecutableName="codg"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Codg</DisplayName>
            <PublisherDisplayName>AtomAI</PublisherDisplayName>
            <Description>Atom codg agent app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="codg.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
